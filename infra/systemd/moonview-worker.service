[Unit]
Description=Moonview Video Worker
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=moonview
Group=moonview
WorkingDirectory=/opt/moonview/current
EnvironmentFile=/etc/moonview/moonview.env
ExecStart=/usr/bin/npm run start:worker --workspace=backend
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=35
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
