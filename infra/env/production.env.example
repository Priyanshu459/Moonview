NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://moonview_user:CHANGE_ME@127.0.0.1:5432/moonview
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
COOKIE_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
CSRF_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
CORS_ORIGINS=https://moonview.example.com
STORAGE_ROOT=/var/lib/moonview/storage
PUBLIC_MEDIA_ROOT=/var/lib/moonview/public-media
PROCESSING_TMP_ROOT=/var/lib/moonview/tmp
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VIDEO_PROCESSING_CONCURRENCY=1
FFMPEG_THREADS=1
STORAGE_MAX_FILE_SIZE_MB=100
