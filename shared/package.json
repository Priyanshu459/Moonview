{
  "name": "@moonview/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types and constants for Moonview",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "rimraf": "^6.0.1"
  }
}
